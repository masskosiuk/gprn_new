NODE_ENV=production
APP_ENV=production

# Public address that will be configured in Caddy below.
APP_URL=https://photos.example.com
API_URL=https://photos.example.com
NEXT_PUBLIC_SITE_URL=https://photos.example.com

# Use long random hexadecimal values. POSTGRES_PASSWORD is URL-safe because it
# is reused below in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
DATABASE_URL=postgresql://gprn:replace_with_openssl_rand_hex_32@postgres:5432/gprn?schema=public
REDIS_URL=redis://redis:6379

SESSION_SECRET=replace_with_openssl_rand_base64_48
ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# Internal Docker address used by API/worker. Public media may later be served
# by a Caddy route or a CDN; do not expose the MinIO console publicly.
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_BUCKET_PUBLIC=gprn-public
S3_BUCKET_PRIVATE=gprn-private
S3_ACCESS_KEY=gprnadmin
S3_SECRET_KEY=replace_with_openssl_rand_hex_32
S3_FORCE_PATH_STYLE=true
CDN_PUBLIC_URL=https://photos.example.com/media

AI_ENABLED=false
MARKETPLACE_ENABLED=false
EXPERT_REVIEWS_ENABLED=false
PAYMENTS_ENABLED=false
ADVANCED_PROVENANCE_ENABLED=false

# Optional, host-local port overrides. Leave unset unless one is already busy.
# WEB_BIND_PORT=13000
# API_BIND_PORT=14000
# MINIO_API_BIND_PORT=19000
# MINIO_CONSOLE_BIND_PORT=19001
