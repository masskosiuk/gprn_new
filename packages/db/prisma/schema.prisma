generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum ProfileTier {
  VIEWER
  AMATEUR
  BEGINNER
  EXPERIENCED
  PROFESSIONAL
  STAR
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PhotoStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  UNDER_REVIEW
  REJECTED
  ARCHIVED
  DELETED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum PhotoAssetType {
  ORIGINAL
  DISPLAY
  THUMBNAIL
  RAW_EVIDENCE
  PROVENANCE_EVIDENCE
}

enum StorageVisibility {
  PUBLIC
  PRIVATE
}

enum OriginType {
  DIRECT_UPLOAD
  GOOGLE_DRIVE
  DROPBOX
  ADOBE
  FLICKR
  FIVE_HUNDRED_PX
  BEHANCE
  OTHER_VERIFIED_SOURCE
}

enum ProvenanceStatus {
  UNVERIFIED
  SOURCE_VERIFIED
  METADATA_SUPPORTED
  ORIGINAL_FILE_SUPPORTED
  PHOTOGRAPHER_VERIFIED
  PROVENANCE_SUPPORTED
  DISPUTED
  UNDER_REVIEW
}

enum HashAlgorithm {
  SHA256
  PHASH
  DHASH
  AHASH
}

enum LocationSource {
  EXIF
  GPS
  USER_SELECTED
  USER_ENTERED
  IMPORTED_METADATA
  VERIFIED_CAPTURE
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  CITY
  REGION
  COUNTRY
  UNKNOWN
}

enum LocationVisibility {
  EXACT
  APPROXIMATE
  CITY
  COUNTRY
  HIDDEN
}

enum SeasonStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ChallengeStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BattleStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum RatingScope {
  GLOBAL
  COUNTRY
  REGION
  CITY
  CATEGORY
  SEASON
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PENDING_EXPERT
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  DISABLED
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  SALE
  PLATFORM_FEE
  DONATION_SENT
  DONATION_RECEIVED
  REFUND
  ADMIN_ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServiceRequestKind {
  SERVICE
  PHOTO_REVIEW
}

enum PromotionPlacement {
  HOME
  MARKETPLACE
  BATTLES
}

enum PromotionStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  EVIDENCE_REQUESTED
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum FeatureFlagScope {
  GLOBAL
  COUNTRY
  USER_GROUP
  USER
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String               @unique
  emailVerifiedAt         DateTime?
  passwordHash            String?
  status                  UserStatus           @default(ACTIVE)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  profile                 Profile?
  roles                   UserRole[]
  sessions                Session[]
  authTokens              AuthToken[]
  externalConnections     ExternalConnection[]
  photos                  Photo[]
  battleVotes             BattleVote[]
  challengeEntries        ChallengeEntry[]
  seasonParticipants      SeasonParticipant[]
  ratings                 Rating[]
  ratingEvents            RatingEvent[]
  achievements            UserAchievement[]
  following               Follow[]             @relation("follow_follower")
  followers               Follow[]             @relation("follow_following")
  notifications           Notification[]
  reports                 Report[]             @relation("report_reporter")
  copyrightDisputes       CopyrightDispute[]   @relation("dispute_claimant")
  auditLogs               AuditLog[]           @relation("audit_actor")
  analyticsEvents         AnalyticsEvent[]
  sellerProfile           SellerProfile?
  expertProfile           ExpertProfile?
  marketplaceOrders       MarketplaceOrder[]   @relation("marketplace_customer")
  expertOrders            ExpertOrder[]        @relation("expert_customer")
  wallet                  Wallet?
  moodboards              Moodboard[]
  photoReviews            PhotoReview[]        @relation("photo_review_author")
  serviceRequestsSent     ServiceRequest[]     @relation("service_customer")
  serviceRequestsReceived ServiceRequest[]     @relation("service_provider")
  serviceMessages         ServiceMessage[]
  serviceRatingsAuthored  ServiceRating[]      @relation("service_rating_author")
  serviceRatingsReceived  ServiceRating[]      @relation("service_rating_subject")
  donationsSent           Donation[]           @relation("donation_sender")
  donationsReceived       Donation[]           @relation("donation_recipient")
  promotions              Promotion[]
  walletAdjustments       WalletTransaction[]  @relation("wallet_transaction_actor")

  @@index([status])
  @@map("users")
}

model Profile {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @unique @db.Uuid
  username             String      @unique
  displayName          String
  bio                  String?
  avatarAssetKey       String?
  coverAssetKey        String?
  websiteUrl           String?
  socialLinks          Json?
  tier                 ProfileTier @default(VIEWER)
  availableForHire     Boolean     @default(true)
  serviceRatingAverage Decimal?    @db.Decimal(3, 2)
  serviceRatingsCount  Int         @default(0)
  completedAsProvider  Int         @default(0)
  completedAsCustomer  Int         @default(0)
  countryId            String?     @db.Uuid
  regionId             String?     @db.Uuid
  cityId               String?     @db.Uuid
  visibility           Visibility  @default(PUBLIC)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country              Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  region               Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  city                 City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([countryId])
  @@index([cityId])
  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  createdAt DateTime         @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}

model ExternalConnection {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  provider              String
  providerAccountId     String
  connectionType        String
  scopes                String[]
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  disconnectedAt        DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider, connectionType])
  @@index([userId])
  @@map("external_connections")
}

model Country {
  id             String                @id @default(uuid()) @db.Uuid
  iso2           String                @unique
  iso3           String?               @unique
  slug           String                @unique
  nameKey        String
  createdAt      DateTime              @default(now())
  profiles       Profile[]
  regions        Region[]
  cities         City[]
  photoLocations PhotoLocation[]
  ratings        Rating[]
  leaderboards   LeaderboardSnapshot[]

  @@map("countries")
}

model Region {
  id             String                @id @default(uuid()) @db.Uuid
  countryId      String                @db.Uuid
  code           String?
  slug           String
  nameKey        String
  createdAt      DateTime              @default(now())
  country        Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  profiles       Profile[]
  cities         City[]
  photoLocations PhotoLocation[]
  ratings        Rating[]
  leaderboards   LeaderboardSnapshot[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@map("regions")
}

model City {
  id             String                @id @default(uuid()) @db.Uuid
  countryId      String                @db.Uuid
  regionId       String?               @db.Uuid
  slug           String
  nameKey        String
  latitude       Decimal?              @db.Decimal(9, 6)
  longitude      Decimal?              @db.Decimal(9, 6)
  createdAt      DateTime              @default(now())
  country        Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region         Region?               @relation(fields: [regionId], references: [id], onDelete: SetNull)
  profiles       Profile[]
  places         Place[]
  photoLocations PhotoLocation[]
  ratings        Rating[]
  leaderboards   LeaderboardSnapshot[]

  @@unique([countryId, regionId, slug])
  @@index([countryId])
  @@index([regionId])
  @@map("cities")
}

model Place {
  id             String          @id @default(uuid()) @db.Uuid
  cityId         String?         @db.Uuid
  slug           String
  nameKey        String
  latitude       Decimal?        @db.Decimal(9, 6)
  longitude      Decimal?        @db.Decimal(9, 6)
  createdAt      DateTime        @default(now())
  city           City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  photoLocations PhotoLocation[]

  @@index([cityId])
  @@map("places")
}

model Category {
  id             String                @id @default(uuid()) @db.Uuid
  parentId       String?               @db.Uuid
  slug           String                @unique
  nameKey        String
  descriptionKey String?
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  parent         Category?             @relation("category_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]            @relation("category_tree")
  photos         Photo[]
  battles        Battle[]
  challenges     Challenge[]
  ratings        Rating[]
  leaderboards   LeaderboardSnapshot[]
  expertServices ExpertService[]
  products       MarketplaceProduct[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Photo {
  id                    String              @id @default(uuid()) @db.Uuid
  ownerId               String              @db.Uuid
  categoryId            String?             @db.Uuid
  title                 String
  description           String?
  status                PhotoStatus         @default(DRAFT)
  visibility            Visibility          @default(PRIVATE)
  moderationStatus      ModerationStatus    @default(PENDING)
  publishedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  owner                 User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category              Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assets                PhotoAsset[]
  metadata              PhotoMetadata?
  hashes                PhotoHash[]
  location              PhotoLocation?
  provenance            PhotoProvenance?
  provenanceEvents      ProvenanceEvent[]
  versions              PhotoVersion[]      @relation("photo_versions")
  derivedVersions       PhotoVersion[]      @relation("photo_derived_versions")
  battleEntries         BattleEntry[]
  challengeEntries      ChallengeEntry[]
  likes                 PhotoLike[]
  comments              Comment[]
  savedBy               SavedPhoto[]
  reports               Report[]
  disputesAsSubject     CopyrightDispute[]  @relation("dispute_subject_photo")
  wonBattles            Battle[]            @relation("battle_winner_photo")
  moodboardItems        MoodboardItem[]
  reviews               PhotoReview[]
  promotions            Promotion[]
  serviceReviewRequests ServiceRequest[]    @relation("service_review_photo")
  marketplaceProduct    MarketplaceProduct?

  @@index([ownerId, status])
  @@index([categoryId, status])
  @@index([visibility, status, publishedAt])
  @@map("photos")
}

model PhotoAsset {
  id                String            @id @default(uuid()) @db.Uuid
  photoId           String            @db.Uuid
  type              PhotoAssetType
  storageVisibility StorageVisibility @default(PRIVATE)
  bucket            String
  storageKey        String
  contentType       String
  byteSize          BigInt
  width             Int?
  height            Int?
  checksumSha256    String?
  createdAt         DateTime          @default(now())
  deletedAt         DateTime?
  photo             Photo             @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey])
  @@index([photoId, type])
  @@map("photo_assets")
}

model PhotoMetadata {
  id                  String    @id @default(uuid()) @db.Uuid
  photoId             String    @unique @db.Uuid
  exifJson            Json?
  cameraMake          String?
  cameraModel         String?
  lensModel           String?
  focalLength         String?
  aperture            String?
  shutterSpeed        String?
  iso                 Int?
  capturedAt          DateTime?
  software            String?
  colorProfile        String?
  orientation         String?
  gpsLatitudePrivate  Decimal?  @db.Decimal(9, 6)
  gpsLongitudePrivate Decimal?  @db.Decimal(9, 6)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  photo               Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([capturedAt])
  @@map("photo_metadata")
}

model PhotoHash {
  id        String        @id @default(uuid()) @db.Uuid
  photoId   String        @db.Uuid
  algorithm HashAlgorithm
  value     String
  createdAt DateTime      @default(now())
  photo     Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, algorithm])
  @@index([algorithm, value])
  @@map("photo_hashes")
}

model PhotoLocation {
  id               String                                @id @default(uuid()) @db.Uuid
  photoId          String                                @unique @db.Uuid
  countryId        String?                               @db.Uuid
  regionId         String?                               @db.Uuid
  cityId           String?                               @db.Uuid
  placeId          String?                               @db.Uuid
  latitudePrivate  Decimal?                              @db.Decimal(9, 6)
  longitudePrivate Decimal?                              @db.Decimal(9, 6)
  publicLatitude   Decimal?                              @db.Decimal(9, 6)
  publicLongitude  Decimal?                              @db.Decimal(9, 6)
  precision        LocationPrecision                     @default(UNKNOWN)
  visibility       LocationVisibility                    @default(HIDDEN)
  source           LocationSource?
  publicLabel      String?
  geoPoint         Unsupported("geography(Point,4326)")?
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt
  photo            Photo                                 @relation(fields: [photoId], references: [id], onDelete: Cascade)
  country          Country?                              @relation(fields: [countryId], references: [id], onDelete: SetNull)
  region           Region?                               @relation(fields: [regionId], references: [id], onDelete: SetNull)
  city             City?                                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  place            Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([visibility, precision])
  @@map("photo_locations")
}

model PhotoProvenance {
  id                       String           @id @default(uuid()) @db.Uuid
  photoId                  String           @unique @db.Uuid
  originType               OriginType       @default(DIRECT_UPLOAD)
  status                   ProvenanceStatus @default(UNVERIFIED)
  sourceProvider           String?
  sourceReferenceEncrypted String?
  originalFileDetected     Boolean          @default(false)
  metadataDetected         Boolean          @default(false)
  captureDateDetected      Boolean          @default(false)
  gpsDetected              Boolean          @default(false)
  duplicateCheckStatus     String?
  internalEvidenceScore    Int?
  publicSummaryKey         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  photo                    Photo            @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([originType])
  @@map("photo_provenance")
}

model ProvenanceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  photoId     String   @db.Uuid
  eventType   String
  evidence    Json?
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now())
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
  @@map("provenance_events")
}

model PhotoVersion {
  id            String   @id @default(uuid()) @db.Uuid
  photoId       String   @db.Uuid
  derivedFromId String?  @db.Uuid
  versionNumber Int
  changeType    String
  changeSummary String?
  createdAt     DateTime @default(now())
  photo         Photo    @relation("photo_versions", fields: [photoId], references: [id], onDelete: Cascade)
  derivedFrom   Photo?   @relation("photo_derived_versions", fields: [derivedFromId], references: [id], onDelete: SetNull)

  @@unique([photoId, versionNumber])
  @@index([derivedFromId])
  @@map("photo_versions")
}

model Season {
  id             String                @id @default(uuid()) @db.Uuid
  slug           String                @unique
  nameKey        String
  descriptionKey String?
  status         SeasonStatus          @default(DRAFT)
  startsAt       DateTime
  endsAt         DateTime
  rules          Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  challenges     Challenge[]
  battles        Battle[]
  participants   SeasonParticipant[]
  ratings        Rating[]
  leaderboards   LeaderboardSnapshot[]

  @@index([status, startsAt, endsAt])
  @@map("seasons")
}

model SeasonParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  seasonId String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())
  metadata Json?
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([userId])
  @@map("season_participants")
}

model Challenge {
  id             String           @id @default(uuid()) @db.Uuid
  seasonId       String?          @db.Uuid
  categoryId     String?          @db.Uuid
  slug           String           @unique
  titleKey       String
  descriptionKey String?
  status         ChallengeStatus  @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  rules          Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  season         Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries        ChallengeEntry[]
  battles        Battle[]

  @@index([status, startsAt, endsAt])
  @@index([categoryId])
  @@map("challenges")
}

model ChallengeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  challengeId String    @db.Uuid
  photoId     String    @db.Uuid
  userId      String    @db.Uuid
  submittedAt DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  photo       Photo     @relation(fields: [photoId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, photoId])
  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_entries")
}

model Battle {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String?       @db.Uuid
  seasonId      String?       @db.Uuid
  challengeId   String?       @db.Uuid
  status        BattleStatus  @default(DRAFT)
  winnerPhotoId String?       @db.Uuid
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  season        Season?       @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  challenge     Challenge?    @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  winnerPhoto   Photo?        @relation("battle_winner_photo", fields: [winnerPhotoId], references: [id], onDelete: SetNull)
  entries       BattleEntry[]
  votes         BattleVote[]
  ratingEvents  RatingEvent[]

  @@index([status, categoryId])
  @@index([seasonId])
  @@map("battles")
}

model BattleEntry {
  id               String            @id @default(uuid()) @db.Uuid
  battleId         String            @db.Uuid
  photoId          String            @db.Uuid
  userId           String            @db.Uuid
  slot             String
  ratingBefore     Int?
  ratingAfter      Int?
  createdAt        DateTime          @default(now())
  battle           Battle            @relation(fields: [battleId], references: [id], onDelete: Cascade)
  photo            Photo             @relation(fields: [photoId], references: [id], onDelete: Restrict)
  selectedVotes    BattleVote[]      @relation("selected_battle_entry")
  evaluationScores BattleVoteScore[]

  @@unique([battleId, photoId])
  @@unique([battleId, slot])
  @@index([userId])
  @@map("battle_entries")
}

model BattleVote {
  id              String            @id @default(uuid()) @db.Uuid
  battleId        String            @db.Uuid
  voterId         String            @db.Uuid
  selectedEntryId String            @db.Uuid
  selectedPhotoId String            @db.Uuid
  weightMinor     Int               @default(100)
  ipHash          String?
  deviceHash      String?
  suspiciousFlag  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  battle          Battle            @relation(fields: [battleId], references: [id], onDelete: Cascade)
  voter           User              @relation(fields: [voterId], references: [id], onDelete: Restrict)
  selectedEntry   BattleEntry       @relation("selected_battle_entry", fields: [selectedEntryId], references: [id], onDelete: Restrict)
  scores          BattleVoteScore[]

  @@unique([battleId, voterId])
  @@index([voterId, createdAt])
  @@index([battleId, createdAt])
  @@map("battle_votes")
}

model BattleVoteScore {
