# Replace photos.example.com with the real subdomain before adding this block
# to /etc/caddy/Caddyfile on the Debian host.
photos.example.com {
    header {
        Strict-Transport-Security "max-age=2592000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    encode zstd gzip
    request_body {
        max_size 100MB
    }

    # Keep /api in the URI: NestJS serves /api/v1 and /api/docs.
    handle /api/* {
        reverse_proxy 127.0.0.1:14000
    }

    # Serve public derivatives only, never the private bucket or admin console.
    handle_path /media/* {
        header Cache-Control "public, max-age=3600, must-revalidate"
        rewrite * /gprn-public{uri}
        reverse_proxy 127.0.0.1:19000
    }

    handle {
        reverse_proxy 127.0.0.1:13000
    }
}
