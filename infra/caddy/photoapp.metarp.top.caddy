# Merge this block into the existing host Caddyfile.
# Replace an existing block for this domain; never add a duplicate.
photoapp.metarp.top {
    encode zstd gzip

    request_body {
        max_size 100MB
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:14000
    }

    handle_path /media/* {
        rewrite * /gprn-public{uri}
        reverse_proxy 127.0.0.1:19000
    }

    handle {
        reverse_proxy 127.0.0.1:13000
    }
}
