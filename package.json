{
  "name": "gprn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "admin:create": "pnpm --filter @gprn/db admin:create",
    "admin:promote": "pnpm --filter @gprn/db admin:promote",
    "build": "turbo build",
    "db:generate": "pnpm --filter @gprn/db db:generate",
    "db:migrate": "pnpm --filter @gprn/db db:migrate",
    "db:seed": "pnpm --filter @gprn/db db:seed",
    "db:seed:demo-battles": "pnpm --filter @gprn/api demo:seed-battles",
    "db:seed:demo-challenges": "pnpm --filter @gprn/api demo:seed-challenges",
    "db:seed:demo-products": "pnpm --filter @gprn/api demo:seed-products",
    "db:refresh:demo-challenge-video": "pnpm --filter @gprn/api demo:refresh-challenge-video",
    "db:repair:media-titles": "pnpm --filter @gprn/api media:repair-titles",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  }
}
