{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@gprn/config": ["packages/config/src/index.ts"],
      "@gprn/db": ["packages/db/src/index.ts"],
      "@gprn/domain": ["packages/domain/src/index.ts"],
      "@gprn/i18n": ["packages/i18n/src/index.ts"],
      "@gprn/rbac": ["packages/rbac/src/index.ts"],
      "@gprn/storage": ["packages/storage/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
